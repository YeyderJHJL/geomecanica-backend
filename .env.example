# ─────────────────────────────────────────────────────────────────────────────
#  Copia este archivo a ".env" y completa los valores
# ─────────────────────────────────────────────────────────────────────────────

# Servidor: hostname, IP, o "host,puerto" (ej: 192.168.1.10,1433)
DB_SERVER=localhost

# Nombre de la base de datos
DB_DATABASE=BBDD_Geoteknia

# Credenciales SQL Server Authentication
# (deja vacío DB_USER y DB_PASSWORD para usar autenticación Windows integrada)
DB_USER=
DB_PASSWORD=

# Driver ODBC instalado en el sistema
# Opciones: "ODBC Driver 17 for SQL Server" / "ODBC Driver 18 for SQL Server"
DB_DRIVER=ODBC Driver 17 for SQL Server

# Clave secreta Flask (cambia esto en producción)
SECRET_KEY=cambia-esto-en-produccion
